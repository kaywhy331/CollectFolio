{
  "name": "collectfolio",
  "version": "0.8.37",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "lint:copy": "node scripts/check-copy.mjs",
    "test": "node --test tests/*.test.js && npm run test:analytics",
    "test:analytics": "PYTHONPATH=analytics/src python3 -m unittest discover -s analytics/tests -p 'test_*.py'",
    "test:forecast-db": "PYTHONPATH=analytics/src python3 tests/postgres/run_forecast_runtime.py",
    "test:tcgcsv-db": "PYTHONPATH=analytics/src python3 tests/postgres/run_tcgcsv_universe_runtime.py",
    "test:tcgcsv-refresh": "node --test tests/tcgcsv-r2-refresh-worker.test.js tests/tcgcsv-refresh-status.test.js",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "check:all": "npm run check && npm run test:browser",
    "qualify:research": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.operator_cli analytics/manifests/tcgcsv-surging-sparks-research.json --pretty",
    "qualify:research:current": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.operator_cli analytics/manifests/tcgcsv-surging-sparks-current-v2.json --pretty --skip-history",
    "forecast:lab": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.forecast_lab_cli",
    "forecast:compile": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.forecast_dataset_cli",
    "history:import": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.historical_import_cli",
    "cardbase:history": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.cardbase_history_cli",
    "tcgcsv:universe": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.tcgcsv_universe_cli",
    "tcgcsv:structural-gap": "PYTHONPATH=analytics/src python3 -m collectfolio_analytics.structural_gap_cli",
    "worker:tcgcsv:types": "wrangler types cloudflare/tcgcsv-refresh/worker-configuration.d.ts --config cloudflare/tcgcsv-refresh/wrangler.jsonc --env production --include-runtime false --check",
    "worker:tcgcsv:dry-run": "wrangler deploy --config cloudflare/tcgcsv-refresh/wrangler.jsonc --env production --dry-run --outdir .wrangler/tcgcsv-refresh-dry-run",
    "check": "node scripts/validate.mjs && node scripts/check-copy.mjs --strict && npm test && node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/blobs": "9.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.62.1",
    "wrangler": "4.123.0"
  }
}
